<?xml version="1.0" encoding="utf-8"?>
<!-- Privacidade primeiro: nenhum dado do app é extraído para a nuvem. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
