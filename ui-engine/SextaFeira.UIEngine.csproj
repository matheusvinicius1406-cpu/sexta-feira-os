<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SextaFeira.UIEngine</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <Description>Sexta-Feira OS UI Engine — HUD components, radial navigation, animations, and themes for the Cognitive HUD.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Graphics" Version="8.0.100" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <!-- ARC reactor rendering. Maui.Graphics has no conic gradient and no
         reliable additive blend, so the reactor is painted with Skia. -->
    <PackageReference Include="SkiaSharp" Version="2.88.7" />
  </ItemGroup>

</Project>
