# =========================================================
# Sexta-Feira OS — configuração do seu kernel privado
# Copie para .env  (cp .env.template .env)  e ajuste.
# O .env NUNCA é commitado.
# =========================================================

# --- Ambiente ---
ENVIRONMENT=development           # development | production
LOG_LEVEL=INFO

# --- Acesso (privacidade) ---
# loopback = só esta máquina (padrão, mais seguro)
# lan      = outros dispositivos na sua rede local (celular, carro...)
# tunnel   = via WireGuard/Tailscale (te acompanha fora de casa, ainda privado)
ACCESS_MODE=loopback
BACKEND_PORT=8000

# --- Dono único (crie sua conta no 1º boot) ---
OWNER_EMAIL=voce@exemplo.com
OWNER_NAME=Seu Nome
OWNER_PASSWORD=troque-por-uma-senha-forte

# Tratar requisição sem token como sendo do dono. Conveniência para o HUD local
# falar com o kernel sem login. DESLIGADO por padrão, e o kernel se recusa a
# aplicá-lo se ENVIRONMENT não for development ou se ACCESS_MODE não for
# loopback — ou seja, jamais quando algo fora desta máquina puder alcançá-lo.
# Antes isso era implícito em todo kernel de desenvolvimento, inclusive um
# exposto na LAN. Ligue só se você entende o que está abrindo.
AUTH_DEV_BYPASS=false

# --- Pareamento de dispositivos (celular/carro/óculos/relógio) ---
# Defina um código; cada novo aparelho o apresenta uma vez para ser pareado.
DEVICE_PAIRING_CODE=

# --- Segurança de token ---
# Em produção é OBRIGATÓRIO. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# --- Cofre de segredos (chaves de API dos conectores, criptografadas) ---
# OBRIGATÓRIO p/ segredos persistirem. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=
CONNECTORS_TIMEOUT_SECONDS=30
CONNECTORS_MAX_RESPONSE_KB=256

# --- Cérebro local (Ollama) ---
# UM modelo faz tudo: conversa, usa ferramentas e enxerga. Ele precisa ter
# 'tools' E 'vision' no Ollama — confira com:
#   curl -s localhost:11434/api/show -d '{"model":"qwen3-vl:4b"}'
# O kernel avisa no boot se faltar alguma das duas.
OLLAMA_ENDPOINT=http://127.0.0.1:11434
BRAIN_MODEL=qwen3-vl:4b            # conversa + ferramentas + visão, 3.3 GB
EMBEDDING_MODEL=nomic-embed-text   # embeddings locais p/ memória (não é modelo de chat)
BRAIN_THINKING=false               # 'pensar antes' custa caro em CPU e ninguém lê
BRAIN_TEMPERATURE=0.7
# Ceiling on generation (num_predict) — paid IN FULL whenever the model
# doesn't stop on its own, which on CPU it routinely doesn't. At ~4.6 tok/s
# (measured on this project's own reference laptop) the old default of 2048
# meant a worst-case chat reply of ~7.5 minutes. Raise it if your machine is
# faster or replies are getting cut short.
BRAIN_MAX_TOKENS=320
TOOLS_ENABLED=true                 # o cérebro age sozinho (lembrar/recuperar/automações)
TOOL_MAX_ROUNDS=4
SUBAGENTS_ENABLED=true             # o cérebro pode delegar a sub-agentes locais
SUBAGENT_MAX_ROUNDS=3
SUBAGENT_ALLOWED_TOOLS=["recall","list_capabilities","call_api"]
SCHEDULER_ENABLED=true             # dispara lembretes/ações agendadas quando vencem
SCHEDULER_INTERVAL_SECONDS=30

# --- Agente próprio (Pulse Cognitivo) ---
# O kernel PENSA e AGE sozinho: a cada intervalo ele acorda, olha o estado
# (mundo, objetivos, aprendizados) e decide se há algo útil a fazer agora.
# Ações de leitura/reversíveis ele executa; ações que mudam o mundo viram
# PROPOSTAS que você aprova ou recusa (POST /api/v1/agent/proposals/...).
AGENT_PULSE_ENABLED=true
AGENT_PULSE_INTERVAL_SECONDS=600    # a cada 10 min o agente acorda e julga
AGENT_PULSE_COOLDOWN_SECONDS=3600   # mesma ação segura só se repete depois de 1h

# --- Memória (segundo cérebro) ---
MEMORY_TOP_K=6
MEMORY_AUTO_LEARN=true             # destila fatos duráveis após cada conversa
GRAPH_RELATION_LABELS=true         # o cérebro NOMEIA as ligações (ex.: "trabalha em")

# --- Voz local (opcional, offline) ---
# Instale o extra: pip install -r requirements-voice.txt
#
# STT (ouvir): faster-whisper — modelo: tiny|base|small|medium|large-v3
#   tiny = mais rápido em CPU (~1GB RAM); small = mais preciso (~2GB RAM)
#
# TTS (falar): Piper — baixe uma voz pt-BR .onnx + .json:
#   1. Acesse https://huggingface.co/rhasspy/piper-voices/tree/main/pt/pt_BR
#   2. Recomendado: pt_BR-faber-medium (masculina, natural, ~50MB)
#      onnx: https://huggingface.co/rhasspy/piper-voices/resolve/main/pt/pt_BR/faber/medium/pt_BR-faber-medium.onnx
#      json: https://huggingface.co/rhasspy/piper-voices/resolve/main/pt/pt_BR/faber/medium/pt_BR-faber-medium.onnx.json
#   3. Coloque os dois arquivos em uma pasta (ex.: C:/piper-voices/)
#   4. Aponte TTS_VOICE para o .onnx
#
# Exemplo:
#   TTS_VOICE=C:/piper-voices/pt_BR-faber-medium.onnx
VOICE_ENABLED=true
STT_MODEL=small                    # tiny|base|small|medium|large-v3
STT_LANGUAGE=pt
STT_DEVICE=cpu                     # cpu|cuda
TTS_VOICE=                        # caminho p/ uma voz Piper .onnx
TTS_SPEAK_REPLIES=true

# --- gRPC (servidor concorrente ao FastAPI) ---
# O servidor gRPC roda na mesma máquina, em porta separada.
# Habilite apenas se você tem clientes gRPC (MAUI, outros dispositivos).
GRPC_ENABLED=true
GRPC_PORT=50051

# --- Automações (Teia — motor próprio, em Python, dentro do kernel) ---
# Não existe runtime externo: o orquestrador e os operários rodam neste processo.
AUTOMATIONS_ENABLED=true
TEIA_MAX_PARALLEL=4               # nós simultâneos por execução
TEIA_MAX_NODES_PER_RUN=200        # trava anti-laço-infinito
TEIA_RUN_TIMEOUT_SECONDS=900      # tempo máximo de uma execução inteira
TEIA_MAX_DEPTH=3                  # profundidade máxima de sub-automações
TEIA_TICK_SECONDS=30              # de quanto em quanto tempo o relógio é conferido
TEIA_TIMEZONE=                    # ex.: America/Sao_Paulo (vazio = horário da máquina)
TEIA_SEED_CATALOG=true            # instala as automações prontas no primeiro boot
# Pastas que os nós de arquivo podem tocar. A workspace já é permitida;
# separe caminhos extras por vírgula.
TEIA_WORKSPACE=
TEIA_ALLOWED_PATHS=
# Rodar programas locais a partir de uma automação. Desligado por padrão;
# quando ligado, só o que estiver na lista roda, e nunca por shell.
TEIA_SHELL_ENABLED=false
TEIA_SHELL_ALLOWLIST=

# --- Banco local ---
DATABASE_URL=sqlite:///./data/sexta_feira_os.db
