{
  "name": "🔌 Sexta-Feira Kernel Bridge",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sexta-callback",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook (gatilho)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300],
      "webhookId": "sexta-callback"
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/api/v1/automations/callback",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "={{ $json.body.action || 'recall' }}"
            },
            {
              "name": "params",
              "value": "={{ $json.body.params || $json.body }}"
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Callback-Secret",
              "value": "={{ $env.N8N_CALLBACK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "http-callback",
      "name": "Chamar Kernel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": []
        }
      },
      "id": "error-handler",
      "name": "Tratar Erro",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 450],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "success",
              "value": "={{ $json.json.ok }}"
            },
            {
              "name": "result",
              "value": "={{ $json.json }}"
            },
            {
              "name": "action_executed",
              "value": "={{ $json.body.action }}"
            }
          ]
        },
        "options": {}
      },
      "id": "format-response",
      "name": "Formatar Resposta",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [650, 300]
    },
    {
      "parameters": {
        "content": "## ✅ Kernel respondeu!\n\n**Ação:** {{ $json.action_executed }}\n\n**Sucesso:** {{ $json.success }}\n\n**Resultado:**\n```json\n{{ JSON.stringify($json.result, null, 2) }}\n```"
      },
      "id": "noop-success",
      "name": "✅ Sucesso",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [850, 200]
    },
    {
      "parameters": {
        "content": "## ❌ Erro no Kernel\n\n**Detalhes:** {{ JSON.stringify($json, null, 2) }}"
      },
      "id": "noop-error",
      "name": "❌ Erro",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [850, 450]
    }
  ],
  "connections": {
    "Webhook (gatilho)": {
      "main": [
        [
          {
            "node": "Chamar Kernel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chamar Kernel": {
      "main": [
        [
          {
            "node": "Formatar Resposta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Formatar Resposta": {
      "main": [
        [
          {
            "node": "✅ Sucesso",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "staticData": null,
  "tags": [],
  "pinData": {}
}
