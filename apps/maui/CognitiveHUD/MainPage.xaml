<?xml version="1.0" encoding="utf-8" ?>
<!--
    ARC — the only screen. Everything else orbits the reactor.

    Layer order matters: the Skia surface paints the reactor, the orbit and
    the hover sector; MAUI controls sit above it for anything that is text,
    because 8-11px type drawn into a canvas is unreadable next to the native
    font rasteriser.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="SextaFeira.CognitiveHUD.MainPage"
             BackgroundColor="{StaticResource Arc.Color.Void}"
             Shell.NavBarIsVisible="False">

    <Grid>

        <!-- 0 · reactor, orbit, wedge — 60 fps -->
        <skia:SKCanvasView x:Name="Surface"
                           EnableTouchEvents="True"
                           PaintSurface="OnPaintSurface"
                           Touch="OnSurfaceTouch"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill" />

        <!-- 1 · orbital captions, positioned from the renderer -->
        <AbsoluteLayout x:Name="OrbitLabels" InputTransparent="True" />

        <!-- 2 · breadcrumb rail -->
        <HorizontalStackLayout Spacing="10"
                               Margin="0,28,0,0"
                               InputTransparent="True"
                               HorizontalOptions="Center"
                               VerticalOptions="Start">
            <BoxView x:Name="Pip0" WidthRequest="5" HeightRequest="5" CornerRadius="3"
                     Color="{StaticResource Arc.Color.Plasma}" VerticalOptions="Center" />
            <BoxView x:Name="Pip1" WidthRequest="4" HeightRequest="4" CornerRadius="2"
                     Color="{StaticResource Arc.Color.InkGhost}" VerticalOptions="Center" />
            <BoxView x:Name="Pip2" WidthRequest="4" HeightRequest="4" CornerRadius="2"
                     Color="{StaticResource Arc.Color.InkGhost}" VerticalOptions="Center" />
            <Label x:Name="Crumb" Text="CORE" Style="{StaticResource Arc.Text.Label}"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- 3 · telemetry corners -->
        <VerticalStackLayout Margin="40,34,0,0" Spacing="10" InputTransparent="True"
                             HorizontalOptions="Start" VerticalOptions="Start">
            <VerticalStackLayout Spacing="3">
                <Label Text="OPERATOR" Style="{StaticResource Arc.Text.Label}" />
                <Label Text="MATHEUS VINICIUS"
                       Style="{StaticResource Arc.Text.Readout}"
                       TextColor="{StaticResource Arc.Color.InkHi}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="3">
                <Label Text="CLEARANCE" Style="{StaticResource Arc.Text.Label}" />
                <Label Text="ROOT · TIER 01" Style="{StaticResource Arc.Text.Readout}" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <VerticalStackLayout Margin="0,34,40,0" Spacing="10" InputTransparent="True"
                             HorizontalOptions="End" VerticalOptions="Start">
            <VerticalStackLayout Spacing="3" HorizontalOptions="End">
                <Label Text="LOCAL" Style="{StaticResource Arc.Text.Label}" HorizontalTextAlignment="End" />
                <Label x:Name="DateOut" Text="—" Style="{StaticResource Arc.Text.Readout}"
                       TextColor="{StaticResource Arc.Color.InkHi}" HorizontalTextAlignment="End" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="3" HorizontalOptions="End">
                <Label Text="UPTIME" Style="{StaticResource Arc.Text.Label}" HorizontalTextAlignment="End" />
                <Label x:Name="UptimeOut" Text="00:00:00" Style="{StaticResource Arc.Text.Readout}"
                       HorizontalTextAlignment="End" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <VerticalStackLayout Margin="40,0,0,34" Spacing="10" InputTransparent="True"
                             HorizontalOptions="Start" VerticalOptions="End">
            <VerticalStackLayout Spacing="3">
                <Label Text="CORE LOAD" Style="{StaticResource Arc.Text.Label}" />
                <Label x:Name="LoadOut" Text="—" Style="{StaticResource Arc.Text.Readout}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="3">
                <Label Text="LATENCY" Style="{StaticResource Arc.Text.Label}" />
                <Label x:Name="LatencyOut" Text="—" Style="{StaticResource Arc.Text.Readout}" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <VerticalStackLayout Margin="0,0,40,34" Spacing="10" InputTransparent="True"
                             HorizontalOptions="End" VerticalOptions="End">
            <Border x:Name="StatusChip"
                    StrokeThickness="1"
                    Stroke="{StaticResource Arc.Color.Hairline}"
                    BackgroundColor="{StaticResource Arc.Color.Glass}"
                    Padding="9,5,12,5"
                    HorizontalOptions="End">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="7">
                    <BoxView x:Name="StatusDot" WidthRequest="5" HeightRequest="5" CornerRadius="3"
                             Color="{StaticResource Arc.Color.Plasma}" VerticalOptions="Center" />
                    <Label x:Name="StatusText" Text="STANDBY" Style="{StaticResource Arc.Text.Label}"
                           TextColor="{StaticResource Arc.Color.Ink}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <VerticalStackLayout Spacing="3" HorizontalOptions="End">
                <Label Text="LINK" Style="{StaticResource Arc.Text.Label}" HorizontalTextAlignment="End" />
                <Label x:Name="LinkOut" Text="GRPC · 127.0.0.1:50051"
                       Style="{StaticResource Arc.Text.Readout}" HorizontalTextAlignment="End" />
            </VerticalStackLayout>
        </VerticalStackLayout>


        <!-- 4 · boot veil -->
        <Grid x:Name="Boot" BackgroundColor="{StaticResource Arc.Color.Void}">
            <VerticalStackLayout Spacing="20" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="ARC" FontFamily="ArcDataLight" FontSize="15"
                       CharacterSpacing="13" TextColor="{StaticResource Arc.Color.InkHi}"
                       HorizontalOptions="Center" />
                <BoxView x:Name="BootTrack" WidthRequest="190" HeightRequest="1"
                         Color="{StaticResource Arc.Color.InkGhost}" HorizontalOptions="Center" />
                <Label x:Name="BootLog" Text="INITIALIZING" Style="{StaticResource Arc.Text.Label}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
