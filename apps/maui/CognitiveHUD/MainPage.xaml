<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SextaFeira.CognitiveHUD.MainPage"
             BackgroundColor="#0A0A12"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- ── HUD Canvas (custom rendered) ────────────── -->
        <GraphicsView x:Name="HudCanvas"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill" />

        <!-- ── Top HUD Overlay ─────────────────────────── -->
        <Grid Padding="16,48,16,16"
              VerticalOptions="Start"
              HorizontalOptions="Fill"
              HeightRequest="48">

            <!-- Breadcrumb -->
            <HorizontalStackLayout Spacing="8"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Start">
                <Label x:Name="DepthDot"
                       Text="●"
                       TextColor="#00E5FF"
                       FontSize="10"
                       VerticalOptions="Center" />
                <Label x:Name="BreadcrumbLabel"
                       Text="Core"
                       TextColor="#8888AA"
                       FontSize="10"
                       FontFamily="Courier New"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Depth Level Indicator -->
            <HorizontalStackLayout Spacing="6"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center">
                <BoxView x:Name="Level1Dot"
                         WidthRequest="6"
                         HeightRequest="6"
                         CornerRadius="3"
                         Color="#00E5FF"
                         VerticalOptions="Center" />
                <BoxView x:Name="Level2Dot"
                         WidthRequest="6"
                         HeightRequest="6"
                         CornerRadius="3"
                         Color="#333355"
                         VerticalOptions="Center" />
                <BoxView x:Name="Level3Dot"
                         WidthRequest="6"
                         HeightRequest="6"
                         CornerRadius="3"
                         Color="#333355"
                         VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Connection Status -->
            <HorizontalStackLayout Spacing="6"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End">
                <BoxView x:Name="StatusDot"
                         WidthRequest="7"
                         HeightRequest="7"
                         CornerRadius="3.5"
                         Color="#666666"
                         VerticalOptions="Center" />
                <Label x:Name="StatusLabel"
                       Text="Desconectado"
                       TextColor="#666666"
                       FontSize="9"
                       FontFamily="Courier New"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>

        <!-- ── Bottom Controls ─────────────────────────── -->
        <HorizontalStackLayout Padding="16,0,16,32"
                                VerticalOptions="End"
                                HorizontalOptions="Center"
                                Spacing="16">

            <Button x:Name="RootButton"
                    Text="⟲"
                    TextColor="#666688"
                    BackgroundColor="#1A1A2E"
                    CornerRadius="18"
                    WidthRequest="36"
                    HeightRequest="36"
                    FontSize="14"
                    IsVisible="False"
                    Clicked="OnRootClicked" />

            <Button x:Name="BackButton"
                    Text="←"
                    TextColor="#8888AA"
                    BackgroundColor="#1A1A2E"
                    CornerRadius="18"
                    WidthRequest="40"
                    HeightRequest="40"
                    FontSize="16"
                    IsVisible="False"
                    Clicked="OnBackClicked" />

            <Button x:Name="ExpandButton"
                    Text="☰"
                    TextColor="#00E5FF"
                    BackgroundColor="#1A1A2E"
                    CornerRadius="22"
                    WidthRequest="48"
                    HeightRequest="48"
                    FontSize="20"
                    Clicked="OnExpandClicked" />

        </HorizontalStackLayout>
    </Grid>

</ContentPage>
