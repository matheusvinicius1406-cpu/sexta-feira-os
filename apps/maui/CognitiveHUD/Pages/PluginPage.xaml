<?xml version="1.0" encoding="utf-8" ?>
<pages:HudBasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:pages="clr-namespace:SextaFeira.CognitiveHUD.Pages"
             x:Class="SextaFeira.CognitiveHUD.Pages.PluginPage"
             BackgroundColor="#0A0A12" Shell.NavBarIsVisible="False">
    <Grid>
        <GraphicsView x:Name="HudCanvas" HorizontalOptions="Fill" VerticalOptions="Fill" />
        <Grid Padding="16,56,16,16" RowDefinitions="Auto,1,*,Auto">
            <HorizontalStackLayout Grid.Row="0" Spacing="24">
                <VerticalStackLayout>
                    <Label Text="INSTALADOS" TextColor="#555577" FontSize="8" FontFamily="ArcData" />
                    <Label Text="0" TextColor="#00E5FF" FontSize="22" FontFamily="ArcData" />
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label Text="ATIVOS" TextColor="#555577" FontSize="8" FontFamily="ArcData" />
                    <Label Text="0" TextColor="#00E676" FontSize="22" FontFamily="ArcData" />
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label Text="MERCADO" TextColor="#555577" FontSize="8" FontFamily="ArcData" />
                    <Label Text="—" TextColor="#7C4DFF" FontSize="22" FontFamily="ArcData" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
            <BoxView Grid.Row="1" HeightRequest="1" Color="#1A1A3E" Margin="0,8" />
            <Frame Grid.Row="2" BackgroundColor="#12121E" BorderColor="#333355"
                   CornerRadius="12" Padding="12" HasShadow="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="🔌 PLUGINS DISPONÍVEIS" TextColor="#555577" FontSize="8" FontFamily="ArcData" />
                    <Label Text="Nenhum plugin instalado" TextColor="#444466" FontSize="11" FontFamily="ArcData" />
                </VerticalStackLayout>
            </Frame>
            <HorizontalStackLayout Grid.Row="3" Spacing="12" HorizontalOptions="Center" Margin="0,8,0,0">
                <Button Text="⟳ descobrir" TextColor="#00E5FF" BackgroundColor="#1A1A2E" CornerRadius="14" FontSize="10" HeightRequest="34" Padding="14,0" />
                <Button Text="⇣ mercado" TextColor="#7C4DFF" BackgroundColor="#1A1A2E" CornerRadius="14" FontSize="10" HeightRequest="34" Padding="14,0" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</pages:HudBasePage>
