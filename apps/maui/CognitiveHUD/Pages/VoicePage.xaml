<?xml version="1.0" encoding="utf-8" ?>
<pages:HudBasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:pages="clr-namespace:SextaFeira.CognitiveHUD.Pages"
             x:Class="SextaFeira.CognitiveHUD.Pages.VoicePage"
             BackgroundColor="#0A0A12" Shell.NavBarIsVisible="False">
    <Grid>
        <GraphicsView x:Name="HudCanvas" HorizontalOptions="Fill" VerticalOptions="Fill" />
        <Grid Padding="16,56,16,24" RowDefinitions="Auto,1,*,Auto">
            <!-- Status row -->
            <HorizontalStackLayout Grid.Row="0" Spacing="24">
                <VerticalStackLayout>
                    <Label Text="STT" TextColor="#555577" FontSize="8" FontFamily="ArcData" />
                    <Label x:Name="SttLabel" Text="—" TextColor="#00E5FF" FontSize="14" FontFamily="ArcData" />
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label Text="TTS" TextColor="#555577" FontSize="8" FontFamily="ArcData" />
                    <Label x:Name="TtsLabel" Text="—" TextColor="#7C4DFF" FontSize="14" FontFamily="ArcData" />
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label Text="ESTADO" TextColor="#555577" FontSize="8" FontFamily="ArcData" />
                    <Label x:Name="VoiceStateLabel" Text="ocioso" TextColor="#FFD600" FontSize="14" FontFamily="ArcData" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <BoxView Grid.Row="1" HeightRequest="1" Color="#1A1A3E" Margin="0,8" />

            <!-- Transcription area -->
            <Frame Grid.Row="2" BackgroundColor="#12121E" BorderColor="#333355"
                   CornerRadius="12" Padding="12" HasShadow="False">
                <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="🎙 TRANSCRIÇÃO" TextColor="#555577" FontSize="8" FontFamily="ArcData" />
                    <Label x:Name="TranscriptLabel" Text="toque para falar"
                           TextColor="#8888AA" FontSize="13" FontFamily="ArcData"
                           HorizontalTextAlignment="Center" />
                    <BoxView HeightRequest="1" Color="#1A1A3E" />
                    <Label x:Name="ReplyLabel" Text=""
                           TextColor="#7C4DFF" FontSize="11" FontFamily="ArcData"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Record controls -->
            <HorizontalStackLayout Grid.Row="3" Spacing="16" HorizontalOptions="Center" Margin="0,12,0,0">
                <Button x:Name="RecordBtn" Text="⏺" TextColor="#FF1744" BackgroundColor="#1A1A2E"
                        CornerRadius="22" WidthRequest="44" HeightRequest="44" FontSize="18" />
                <Button Text="▶ ouvir" TextColor="#00E5FF" BackgroundColor="#1A1A2E"
                        CornerRadius="14" FontSize="10" HeightRequest="34" Padding="14,0" />
                <Button Text="⏹ parar" TextColor="#8888AA" BackgroundColor="#1A1A2E"
                        CornerRadius="14" FontSize="10" HeightRequest="34" Padding="14,0" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</pages:HudBasePage>
