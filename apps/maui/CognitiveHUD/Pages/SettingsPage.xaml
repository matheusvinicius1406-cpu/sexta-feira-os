<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SextaFeira.CognitiveHUD.Pages.SettingsPage"
             BackgroundColor="#0A0A12" Shell.NavBarIsVisible="False">
    <Grid>
        <GraphicsView x:Name="HudCanvas" HorizontalOptions="Fill" VerticalOptions="Fill" />
        <Grid Padding="16,56,16,24" RowDefinitions="Auto,1,*,Auto">
            <!-- Connection status -->
            <Frame Grid.Row="0" BackgroundColor="#12121E" BorderColor="#333355"
                   CornerRadius="12" Padding="12" HasShadow="False">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Frame x:Name="StatusDot" BackgroundColor="#666666" CornerRadius="5" WidthRequest="10" HeightRequest="10" HasShadow="False" Padding="0" VerticalOptions="Center" />
                    <Label Grid.Column="1" x:Name="StatusLabel" Text="Desconectado" TextColor="#8888AA" FontSize="10" FontFamily="Courier New" Margin="10,0" VerticalOptions="Center" />
                    <Button Grid.Column="2" Text="⟳ testar" TextColor="#00E5FF" BackgroundColor="#1A1A2E" CornerRadius="10" FontSize="9" HeightRequest="28" Padding="10,0" />
                </Grid>
            </Frame>
            <BoxView Grid.Row="1" HeightRequest="1" Color="#1A1A3E" Margin="0,8" />
            <ScrollView Grid.Row="2">
                <VerticalStackLayout Spacing="6">
                    <Frame BackgroundColor="#12121E" BorderColor="#2A2A4E" CornerRadius="8" Padding="10" HasShadow="False">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Servidor" TextColor="#E0E0FF" FontSize="10" FontFamily="Courier New" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="127.0.0.1:50051" TextColor="#555577" FontSize="10" FontFamily="Courier New" VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                    <Frame BackgroundColor="#12121E" BorderColor="#2A2A4E" CornerRadius="8" Padding="10" HasShadow="False">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Tema" TextColor="#E0E0FF" FontSize="10" FontFamily="Courier New" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Neon Dark" TextColor="#555577" FontSize="10" FontFamily="Courier New" VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                    <Frame BackgroundColor="#12121E" BorderColor="#2A2A4E" CornerRadius="8" Padding="10" HasShadow="False">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Idioma" TextColor="#E0E0FF" FontSize="10" FontFamily="Courier New" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="pt-BR" TextColor="#555577" FontSize="10" FontFamily="Courier New" VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
