<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SextaFeira.CognitiveHUD.Pages.PlanningPage"
             BackgroundColor="#0A0A12" Shell.NavBarIsVisible="False">
    <Grid>
        <GraphicsView x:Name="HudCanvas" HorizontalOptions="Fill" VerticalOptions="Fill" />
        <Grid Padding="16,56,16,16" RowDefinitions="Auto,1,*,Auto">
            <HorizontalStackLayout Grid.Row="0" Spacing="24">
                <VerticalStackLayout>
                    <Label Text="ATIVOS" TextColor="#555577" FontSize="8" FontFamily="Courier New" />
                    <Label Text="3" TextColor="#00E5FF" FontSize="22" FontFamily="Courier New" />
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label Text="CONCLUÍDOS" TextColor="#555577" FontSize="8" FontFamily="Courier New" />
                    <Label Text="12" TextColor="#00E676" FontSize="22" FontFamily="Courier New" />
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label Text="TAXA" TextColor="#555577" FontSize="8" FontFamily="Courier New" />
                    <Label Text="80%" TextColor="#7C4DFF" FontSize="22" FontFamily="Courier New" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
            <BoxView Grid.Row="1" HeightRequest="1" Color="#1A1A3E" Margin="0,8" />
            <ScrollView Grid.Row="2">
                <VerticalStackLayout Spacing="6">
                    <Frame BackgroundColor="#12121E" BorderColor="#2A2A4E" CornerRadius="10" Padding="10" HasShadow="False">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <Label Text="Otimizar buscas" TextColor="#E0E0FF" FontSize="11" FontFamily="Courier New" />
                            <BoxView Grid.Row="1" HeightRequest="4" CornerRadius="2" Color="#1A1A3E" Margin="0,4" />
                            <BoxView Grid.Row="1" HeightRequest="4" CornerRadius="2" Color="#00E5FF" Margin="0,4" HorizontalOptions="Start" WidthRequest="180" />
                            <Label Grid.Row="2" Text="3/5 passos" TextColor="#555577" FontSize="8" FontFamily="Courier New" />
                        </Grid>
                    </Frame>
                    <Frame BackgroundColor="#12121E" BorderColor="#2A2A4E" CornerRadius="10" Padding="10" HasShadow="False">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <Label Text="Aprender preferências" TextColor="#E0E0FF" FontSize="11" FontFamily="Courier New" />
                            <BoxView Grid.Row="1" HeightRequest="4" CornerRadius="2" Color="#1A1A3E" Margin="0,4" />
                            <BoxView Grid.Row="1" HeightRequest="4" CornerRadius="2" Color="#7C4DFF" Margin="0,4" HorizontalOptions="Start" WidthRequest="90" />
                            <Label Grid.Row="2" Text="1/4 passos" TextColor="#555577" FontSize="8" FontFamily="Courier New" />
                        </Grid>
                    </Frame>
                    <Frame BackgroundColor="#12121E" BorderColor="#2A2A4E" CornerRadius="10" Padding="10" HasShadow="False">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <Label Text="Melhorar respostas" TextColor="#E0E0FF" FontSize="11" FontFamily="Courier New" />
                            <BoxView Grid.Row="1" HeightRequest="4" CornerRadius="2" Color="#1A1A3E" Margin="0,4" />
                            <BoxView Grid.Row="1" HeightRequest="4" CornerRadius="2" Color="#FFD600" Margin="0,4" HorizontalOptions="Start" WidthRequest="240" />
                            <Label Grid.Row="2" Text="4/5 passos" TextColor="#555577" FontSize="8" FontFamily="Courier New" />
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
            </ScrollView>
            <HorizontalStackLayout Grid.Row="3" Spacing="12" HorizontalOptions="Center" Margin="0,8,0,0">
                <Button Text="◈ novo plano" TextColor="#00E5FF" BackgroundColor="#1A1A2E" CornerRadius="14" FontSize="10" HeightRequest="34" Padding="14,0" />
                <Button Text="⏹ cancelar" TextColor="#FF1744" BackgroundColor="#1A1A2E" CornerRadius="14" FontSize="10" HeightRequest="34" Padding="14,0" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
