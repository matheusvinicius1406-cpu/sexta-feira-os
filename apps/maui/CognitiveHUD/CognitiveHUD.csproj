<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-android;net8.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>SextaFeira.CognitiveHUD</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>Sexta-Feira</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.sextafeira.cognitivehud</ApplicationId>
    <ApplicationIdGuid>A1B2C3D4-E5F6-7890-ABCD-EF1234567890</ApplicationIdGuid>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>

    <!-- Unpackaged Win32 build. There is no AppxManifest and this runs as a
         desktop executable, not an MSIX deployment. Without this the Windows
         SDK targets fail before the compiler is ever reached. -->
    <WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>

    <!-- Ship the Windows App Runtime alongside the executable.
         Unpackaged WinUI apps otherwise need the matching runtime installed
         machine-wide; MAUI 8 pulls WindowsAppSDK 1.5, and a machine with only
         1.1/1.7/1.8 fails in the bootstrapper — the process starts, never
         creates a window, and exits silently with no event-log entry. -->
    <WindowsAppSDKSelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</WindowsAppSDKSelfContained>
    <SelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.100" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="8.0.100" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <!-- SpeechToText. TTS comes from MAUI Essentials; STT does not exist
         there in .NET 8, so the toolkit supplies the on-device recogniser. -->
    <PackageReference Include="CommunityToolkit.Maui" Version="9.1.0" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="2.88.7" />
    <!-- gRPC -->
    <PackageReference Include="Grpc.Net.Client" Version="2.62.0" />
    <PackageReference Include="Google.Protobuf" Version="3.27.0" />
    <PackageReference Include="Grpc.Tools" Version="2.62.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\ui-engine\SextaFeira.UIEngine.csproj" />
  </ItemGroup>

  <!-- ARC typography. The MAUI SDK auto-globs *.xaml as MauiXaml but not
       fonts, so these must be declared. The OFL licences ship alongside the
       .ttf files as the licence requires, but are not fonts themselves. -->
  <ItemGroup>
    <MauiFont Include="Resources\Fonts\*.ttf" />
    <None Include="Resources\Fonts\*.txt" />
  </ItemGroup>

  <!-- gRPC proto files — auto-generate C# stubs at build time.
       ProtoRoot is explicit because the .proto files live outside the project
       cone; without it Grpc.Tools guesses per-file roots, which breaks as soon
       as one proto imports another. -->
  <ItemGroup>
    <Protobuf Include="..\..\..\shared\protobuf\*.proto"
              ProtoRoot="..\..\..\shared\protobuf"
              GrpcServices="Client" />
  </ItemGroup>

  <!-- Grpc.Tools hooks codegen to BeforeCompile, which is reached through
       CoreCompile. On Windows that is too late and never happens: the WinUI
       markup pipeline compiles the whole assembly first via XamlPreCompile
       (output lands in obj\...\intermediatexaml\), that pass fails on the
       missing SextaFeira.*.V1 types, and the build aborts before CoreCompile
       is ever reached. Running codegen ahead of XamlPreCompile fixes it;
       CoreCompile stays listed for the Android head, which has no XAML pass. -->
  <Target Name="_ArcProtobufCodegen"
          BeforeTargets="XamlPreCompile;CoreCompile"
          DependsOnTargets="Protobuf_Compile" />

</Project>
