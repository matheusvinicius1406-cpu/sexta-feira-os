<?xml version="1.0" encoding="UTF-8" ?>
<!--
    ARC Design System — type scale and text styles.

    Two families, two roles (docs/design-system/02-TIPOGRAFIA.md):
      ArcDisplay  — Rajdhani. The clock, panel titles, the boot mark.
      ArcData     — JetBrains Mono. Every label, readout and telemetry value.

    Mono is the primary voice because the content is telemetry: fixed widths
    keep number columns aligned and the mechanical texture belongs to the
    subject. Display appears only where size justifies personality.

    Registered aliases (MauiProgram.ConfigureFonts). Always reference the
    alias, never the file name — the file is an implementation detail.

        ArcDisplayLight   Rajdhani-Light.ttf          clock, boot mark
        ArcDisplay        Rajdhani-Regular.ttf        section headings
        ArcDisplayMedium  Rajdhani-Medium.ttf         emphasis
        ArcDisplayBold    Rajdhani-Bold.ttf           J.A.R.V.I.S. wordmark
        ArcDataLight      JetBrainsMono-Light.ttf     quiet body
        ArcData           JetBrainsMono-Regular.ttf   body, readouts
        ArcDataMedium     JetBrainsMono-Medium.ttf    labels

    Both families are SIL OFL 1.1; the licences ship in Resources/Fonts
    alongside the .ttf files, as the licence requires.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ══ Scale — seven steps, no values in between ═══════ -->
    <x:Double x:Key="Arc.Size.Title">22</x:Double>
    <x:Double x:Key="Arc.Size.Heading">15</x:Double>
    <x:Double x:Key="Arc.Size.Body">13</x:Double>
    <x:Double x:Key="Arc.Size.Readout">11</x:Double>
    <x:Double x:Key="Arc.Size.Label">9</x:Double>
    <x:Double x:Key="Arc.Size.Micro">8</x:Double>

    <!-- ══ Tracking ════════════════════════════════════════
         MAUI CharacterSpacing is in device-independent units,
         not em. These are the em values from the spec resolved
         at each step's own size. -->
    <x:Double x:Key="Arc.Track.Title">6.6</x:Double>
    <x:Double x:Key="Arc.Track.Heading">3.3</x:Double>
    <x:Double x:Key="Arc.Track.Body">0.8</x:Double>
    <x:Double x:Key="Arc.Track.Readout">1.3</x:Double>
    <x:Double x:Key="Arc.Track.Label">2.3</x:Double>
    <x:Double x:Key="Arc.Track.Micro">1.9</x:Double>

    <!-- ══ Text styles ═════════════════════════════════════ -->

    <Style x:Key="Arc.Text.Title" TargetType="Label">
        <Setter Property="FontFamily" Value="ArcDisplayLight" />
        <Setter Property="FontSize" Value="{StaticResource Arc.Size.Title}" />
        <Setter Property="CharacterSpacing" Value="{StaticResource Arc.Track.Title}" />
        <Setter Property="TextColor" Value="{StaticResource Arc.Color.InkHi}" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="LineHeight" Value="1.15" />
    </Style>

    <Style x:Key="Arc.Text.Heading" TargetType="Label">
        <Setter Property="FontFamily" Value="ArcDisplay" />
        <Setter Property="FontSize" Value="{StaticResource Arc.Size.Heading}" />
        <Setter Property="CharacterSpacing" Value="{StaticResource Arc.Track.Heading}" />
        <Setter Property="TextColor" Value="{StaticResource Arc.Color.InkHi}" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="LineHeight" Value="1.15" />
    </Style>

    <Style x:Key="Arc.Text.Body" TargetType="Label">
        <Setter Property="FontFamily" Value="ArcData" />
        <Setter Property="FontSize" Value="{StaticResource Arc.Size.Body}" />
        <Setter Property="CharacterSpacing" Value="{StaticResource Arc.Track.Body}" />
        <Setter Property="TextColor" Value="{StaticResource Arc.Color.Ink}" />
        <Setter Property="LineHeight" Value="1.6" />
    </Style>

    <!-- Telemetry. Mono is tabular by construction, so number columns
         never jitter — but pad values with leading zeros anyway so the
         width does not change as the value does. -->
    <Style x:Key="Arc.Text.Readout" TargetType="Label">
        <Setter Property="FontFamily" Value="ArcData" />
        <Setter Property="FontSize" Value="{StaticResource Arc.Size.Readout}" />
        <Setter Property="CharacterSpacing" Value="{StaticResource Arc.Track.Readout}" />
        <Setter Property="TextColor" Value="{StaticResource Arc.Color.Ink}" />
    </Style>

    <Style x:Key="Arc.Text.Label" TargetType="Label">
        <Setter Property="FontFamily" Value="ArcDataMedium" />
        <Setter Property="FontSize" Value="{StaticResource Arc.Size.Label}" />
        <Setter Property="CharacterSpacing" Value="{StaticResource Arc.Track.Label}" />
        <Setter Property="TextColor" Value="{StaticResource Arc.Color.InkLo}" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <!-- 8px floor. Permitted only for orbital labels, which are uppercase,
         tracked, at InkLo or brighter, and redundant with an icon and a
         fixed angular position. Nothing else in the system uses it. -->
    <Style x:Key="Arc.Text.Micro" TargetType="Label">
        <Setter Property="FontFamily" Value="ArcDataMedium" />
        <Setter Property="FontSize" Value="{StaticResource Arc.Size.Micro}" />
        <Setter Property="CharacterSpacing" Value="{StaticResource Arc.Track.Micro}" />
        <Setter Property="TextColor" Value="{StaticResource Arc.Color.InkLo}" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <!-- The clock. The only large numeral in the system; it lives below
         the reactor, never inside it — the core is the brightest region
         on screen and text there would be unreadable. -->
    <!-- ArcDataLight, not the display face: Rajdhani ships four files that
         all share the internal family name "Rajdhani", and the Windows font
         loader fails to pick a weight from that — the label rendered blank.
         JetBrains Mono gives each weight its own family name and resolves. -->
    <Style x:Key="Arc.Text.Clock" TargetType="Label">
        <Setter Property="FontFamily" Value="ArcDataLight" />
        <Setter Property="FontSize" Value="46" />
        <Setter Property="CharacterSpacing" Value="9" />
        <Setter Property="TextColor" Value="{StaticResource Arc.Color.InkHi}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
