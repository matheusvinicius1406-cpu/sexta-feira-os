<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SextaFeira.CognitiveHUD.App">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                ARC Design System.

                Colours must be merged before typography: the text styles
                resolve Arc.Color.* keys at parse time, and a merged
                dictionary can only see what was merged before it.

                Every colour, size and spacing value in the app comes from
                here. No literals in pages — docs/design-system/07-CHECKLISTS.md §3.1.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Arc.Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Arc.Typography.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
