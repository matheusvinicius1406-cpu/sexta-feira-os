<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SextaFeira.CognitiveHUD.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Neon Dark Theme Colors -->
            <Color x:Key="BackgroundColor">#0A0A12</Color>
            <Color x:Key="SurfaceColor">#12121E</Color>
            <Color x:Key="PrimaryColor">#00E5FF</Color>
            <Color x:Key="SecondaryColor">#7C4DFF</Color>
            <Color x:Key="AccentColor">#FF6D00</Color>
            <Color x:Key="TextPrimaryColor">#E0E0FF</Color>
            <Color x:Key="TextSecondaryColor">#8888AA</Color>
            <Color x:Key="GlowColor">#00E5FF</Color>
            <Color x:Key="ErrorColor">#FF1744</Color>
            <Color x:Key="SuccessColor">#00E676</Color>

            <!-- Font Sizes -->
            <x:Double x:Key="FontSizeSmall">10</x:Double>
            <x:Double x:Key="FontSizeMedium">14</x:Double>
            <x:Double x:Key="FontSizeLarge">18</x:Double>
            <x:Double x:Key="FontSizeXLarge">24</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
