{
  "name": "AI Pesquisador: Analista Noticias",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sexta/agent/pesquisa/05",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "id": "ecb10488",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/api/v1/automations/callback",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "recall"
            },
            {
              "name": "params",
              "value": "{\"query\": \"={{ $json.body.message }}\"}"
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Callback-Secret",
              "value": "={ $env.N8N_CALLBACK_SECRET }"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "eff01e2d",
      "name": "Kernel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/api/v1/automations/callback",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "world"
            },
            {
              "name": "params",
              "value": "{\"query\": \"={{ $json.body.message }}\"}"
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Callback-Secret",
              "value": "={ $env.N8N_CALLBACK_SECRET }"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "d0014182",
      "name": "Kernel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:11434/api/chat",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "llama3.2"
            },
            {
              "name": "messages",
              "value": "[{\"role\": \"system\", \"content\": \"Voce e Analista Noticias, um sub-agente especialista da Sexta-Feira. Pesquise na memoria primeiro, depois raciocine com base no que encontrar. Seja conciso e direto, entregue resultados acionaveis.\"}, {\"role\": \"user\", \"content\": \"Pergunta: {{ $json.body.message }}\\n\\nMemoria: {{ $('Kernel').first().json.results }}\\n\\nContexto: {{ $('Kernel').last().json.state }}\"}]"
            },
            {
              "name": "stream",
              "value": false
            },
            {
              "name": "options",
              "value": "{\"temperature\": 0.7, \"num_predict\": 1024}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "786aa811",
      "name": "Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/api/v1/automations/callback",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "remember"
            },
            {
              "name": "params",
              "value": "{\"query\": \"={{ $json.body.message }}\", \"content\": \"={{ 'Pergunta: ' + $json.body.message + ' - Resposta: ' + $json.json.message.content }}\", \"kind\": \"conversa_ia\"}"
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Callback-Secret",
              "value": "={ $env.N8N_CALLBACK_SECRET }"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "93f96530",
      "name": "Kernel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "resposta",
              "value": "={{ $('Ollama').item.json.message.content }}"
            },
            {
              "name": "fontes",
              "value": "={{ $('Kernel').first().item.json.count + ' registros' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "f47788d8",
      "name": "Formatar",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        850,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Kernel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Kernel": {
      "main": [
        [
          {
            "node": "Formatar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ollama": {
      "main": [
        [
          {
            "node": "Kernel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}