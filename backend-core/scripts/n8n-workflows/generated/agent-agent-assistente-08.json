{
  "name": "AI Assistente: Assistente Estudos",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sexta/agent/assistente/08",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "id": "636254b9",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/api/v1/automations/callback",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "recall"
            },
            {
              "name": "params",
              "value": "{\"query\": \"={{ $json.body.message }}\"}"
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Callback-Secret",
              "value": "={ $env.N8N_CALLBACK_SECRET }"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "82c03e21",
      "name": "Kernel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/api/v1/automations/callback",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "world"
            },
            {
              "name": "params",
              "value": "{\"query\": \"={{ $json.body.message }}\"}"
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Callback-Secret",
              "value": "={ $env.N8N_CALLBACK_SECRET }"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "6aa7f025",
      "name": "Kernel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:11434/api/chat",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "llama3.2"
            },
            {
              "name": "messages",
              "value": "[{\"role\": \"system\", \"content\": \"Voce e Assistente Estudos, um assistente pessoal da Sexta-Feira. Seja prestativo, amigavel e eficiente. Use o contexto da memoria para personalizar suas respostas.\"}, {\"role\": \"user\", \"content\": \"Pergunta: {{ $json.body.message }}\\n\\nMemoria: {{ $('Kernel').first().json.results }}\\n\\nContexto: {{ $('Kernel').last().json.state }}\"}]"
            },
            {
              "name": "stream",
              "value": false
            },
            {
              "name": "options",
              "value": "{\"temperature\": 0.7, \"num_predict\": 1024}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "a5a597cb",
      "name": "Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/api/v1/automations/callback",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "remember"
            },
            {
              "name": "params",
              "value": "{\"query\": \"={{ $json.body.message }}\", \"content\": \"={{ 'Pergunta: ' + $json.body.message + ' - Resposta: ' + $json.json.message.content }}\", \"kind\": \"conversa_ia\"}"
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Callback-Secret",
              "value": "={ $env.N8N_CALLBACK_SECRET }"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "6f97ab0e",
      "name": "Kernel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "resposta",
              "value": "={{ $('Ollama').item.json.message.content }}"
            },
            {
              "name": "fontes",
              "value": "={{ $('Kernel').first().item.json.count + ' registros' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "c6412866",
      "name": "Formatar",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        850,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Kernel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Kernel": {
      "main": [
        [
          {
            "node": "Formatar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ollama": {
      "main": [
        [
          {
            "node": "Kernel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}