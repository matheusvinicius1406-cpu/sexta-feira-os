{
  "name": "Casa: Luz Cozinha",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sexta/casa/world_set",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "id": "dc1de33d",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/api/v1/automations/callback",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "action"
            },
            {
              "name": "params",
              "value": "{\"query\": \"={{ $json.body.message }}\", \"device\": \"celular\", \"action\": \"world_set\", \"params\": {\"dispositivo\": \"Luz Cozinha\", \"estado\": \"={{ $json.body.estado || 'ligar' }}\"}}"
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Callback-Secret",
              "value": "={ $env.N8N_CALLBACK_SECRET }"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "47038022",
      "name": "Kernel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "result",
              "value": "={{ $json }}"
            }
          ]
        },
        "options": {}
      },
      "id": "62edc2cf",
      "name": "Formatar",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        850,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Kernel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Kernel": {
      "main": [
        [
          {
            "node": "Formatar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}